# Copy to .env, then supply your own values. Never commit .env.
SWAP_MODE=local
PORT=3001
SWAP_PUBLIC_URL=http://localhost:5173
SWAP_ORIGIN=http://localhost:5173
# SWAP_DB=data/swap.sqlite
# Production: NODE_ENV=production, SWAP_MODE=production, HTTPS URL and SWAP_SECURE=1.

# Real email. If absent, localhost offers explicitly labeled preview links.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=UniSwap <your-owned-mailbox@example.edu.vn>

# VNPAY credentials issued for YOUR merchant. No default shared secret is provided.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
VNPAY_ENV=sandbox
# IPN: https://your-domain.example/api/payments/vnpay/ipn
# Sandbox credentials differ from live credentials. Keep sandbox until certified.

# Optional local demo content (default enabled in local mode).
# SWAP_DEMO=0 stops adding demo content; it does not delete existing demo rows.
